{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stand": "vite --mode stand",
    "build": "vite build",
    "build:stand": "vite build --mode stand",
